*.lib

# Compiled Python bytecode
*.py[cod]

# Unit test reports
TEST*.xml

# Log files
*.log

# Package files
*.jar
*.launch
*.Debug.launch

# Maven
target/
dist/

# IDE
.idea/
.vscode/
